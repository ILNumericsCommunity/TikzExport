<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ILNAcceleratorEnabled>false</ILNAcceleratorEnabled>
    <Nullable>enable</Nullable>
    <RootNamespace>ILNumerics.Community.TikzExport</RootNamespace>
    <AssemblyName>ILNumerics.Community.TikzExport</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ILNumerics.Computing" Version="7.4.62" />
    <PackageReference Include="ILNumerics.Community.Analyzers" Version="7.7.0.298" PrivateAssets="all" />
    <PackageReference Include="ILNumerics.Drawing" Version="7.4.62" />
    <PackageReference Include="ILNumerics.Toolboxes.Drawing2" Version="7.4.62" />
    <PackageReference Include="AnyAscii" Version="0.3.3" />
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/HeadlessPlotPreparation.cs" Link="Shared/HeadlessPlotPreparation.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TikzExport.Tests" />
  </ItemGroup>
</Project>
